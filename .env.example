# PostgreSQL connection string
DATABASE_URL=postgres://tutortrack:tutortrack@localhost:5432/tutortrack
# Set to true when the database requires TLS without a trusted CA (some hosted providers)
DATABASE_SSL=false
# Public address of the site (used in password-reset links)
APP_URL=http://localhost:3000
PORT=3000
# Optional: SMTP for password-reset e-mails. Without it, links are printed in the server log.
SMTP_URL=
MAIL_FROM=TutorTrack <no-reply@twojadomena.pl>
# E-mail(s) of administrators (comma-separated). They get the admin panel at /admin.
ADMIN_EMAILS=
